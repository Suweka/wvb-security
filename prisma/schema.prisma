datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                String    @id @default(cuid())
  email             String?   @unique     // optional — phone-only users may not have email
  phone             String?   @unique     // for OTP login
  name              String?
  password          String?               // null for OAuth/OTP users
  role              Role      @default(GUEST)
  avatarUrl         String?
  country           String?
  address           String?
  preferredLanguage String?   @default("en")
  phoneVerified     Boolean   @default(false)
  emailVerified     DateTime?

  // Loyalty
  loyaltyPoints     Int         @default(0)
  loyaltyTier       LoyaltyTier @default(BRONZE)

  // Relations
  accounts          Account[]
  sessions          Session[]
  bookings          Booking[]
  reviews           Review[]
  savedPayments     SavedPayment[]
  assignedTasks     Task[]        @relation("AssignedTo")

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

enum LoyaltyTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

// NextAuth OAuth table
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

// OTP codes (for phone verification)
model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  @@index([phone])
}

// Saved Payment Methods
model SavedPayment {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   // CARD, HELAPAY, WEBXPAY, BANK
  label       String   // e.g. "Visa ending in 4242"
  token       String?  // gateway token (never store raw card details)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// Guest Checkout (no account needed)
model GuestCheckout {
  id        String    @id @default(cuid())
  email     String
  firstName String
  lastName  String
  phone     String
  country   String?
  // Collected in the booking form only when foreign-pricing is enabled
  // (see /admin/pricing) — NIC for a LOCAL-market guest, passport for a
  // FOREIGN-market one. Only one of the two is ever populated per booking.
  nicNumber      String?
  passportNumber String?
  bookings  Booking[]
  // If guest later registers, link their bookings
  claimedByUserId String?
  createdAt DateTime @default(now())
}

model Booking {
  id              String         @id @default(cuid())
  bookingNumber   String         @unique
  userId          String?
  user            User?          @relation(fields: [userId], references: [id])
  guestCheckoutId String?
  guestCheckout   GuestCheckout? @relation(fields: [guestCheckoutId], references: [id])
  roomId          String
  room            Room           @relation(fields: [roomId], references: [id])
  checkIn         DateTime
  checkOut        DateTime
  guests          Int
  totalAmount     Decimal        @db.Decimal(10, 2)
  status          BookingStatus  @default(PENDING)
  paymentStatus   PaymentStatus  @default(PENDING)
  paymentMethod   String?
  specialRequests String?
  pointsEarned    Int            @default(0)
  // Where this booking came from. Defaults to WEBSITE so the existing guest
  // booking flow (app/api/bookings/route.ts) needs no changes — only manual
  // admin-created bookings (phone/WhatsApp/walk-in) set this explicitly.
  source          BookingSource  @default(WEBSITE)
  
  // Relations
  services            ServiceBooking[]
  payment             Payment?
  bankTransferReceipt BankTransferReceipt?
  refundRequest       RefundRequest?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

// A guest's request to be refunded after cancelling a paid booking, filed
// automatically by the self-service cancel flow (app/api/bookings/cancel).
// `amount` is the policy-computed refundable amount at cancellation time
// (see lib/refund-policy.ts); the admin approves (possibly editing the
// amount) or rejects it from /admin/reservations. Attached to the PRIMARY
// booking row of a multi-room reservation, since the payment is too.
model RefundRequest {
  id          String              @id @default(cuid())
  bookingId   String              @unique
  booking     Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  reason      String?             // guest's optional free-text reason
  amount      Decimal             @db.Decimal(10, 2) // policy-computed refundable LKR amount
  rule        String              // 'FULL' | 'PARTIAL' | 'NONE' — which policy tier applied
  status      RefundRequestStatus @default(PENDING)
  processedAt DateTime?
  processedBy String?             // admin email
  adminNote   String?             // e.g. rejection reason
  createdAt   DateTime            @default(now())
}

model BankTransferReceipt {
  id             String        @id @default(cuid())
  bookingId      String        @unique
  booking        Booking       @relation(fields: [bookingId], references: [id])
  transactionRef String?
  transferDate   DateTime?
  amountPaid     Decimal?      @db.Decimal(10, 2)
  receiptUrl     String?
  notes          String?
  status         ReceiptStatus @default(PENDING)
  reviewedAt     DateTime?
  reviewedBy     String?
  createdAt      DateTime      @default(now())
}

// =======================
// ENUMS
// =======================

enum Role {
  GUEST
  USER
  ADMIN
  STAFF
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// How a booking reached us — almost all bookings are WEBSITE (the normal
// guest booking flow); the other three are logged manually by an admin via
// the "New Reservation" button on /admin/reservations, for guests who
// called, messaged on WhatsApp, or booked in person at the front desk.
enum BookingSource {
  WEBSITE
  PHONE
  WHATSAPP
  WALK_IN
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum TaskCategory {
  HOUSEKEEPING
  MAINTENANCE
  CONFERENCE_SETUP
  OTHER
}

enum ReceiptStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RefundRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// =======================
// MODELS
// =======================

model Room {
  id          String    @id @default(uuid())
  slug        String?   @unique // generated once at creation from name, immutable; nullable at DB level to keep migration simple
  name        String
  description String?
  price       Decimal   @db.Decimal(10, 2)
  maxGuests   Int       @default(2)
  size        Int       @default(300) // sqft
  beds        String?   // e.g. "1 King Bed"

  // Relations
  images      RoomImage[]
  facilities  Facility[]
  bookings    Booking[]
  reviews     Review[]
  tasks       Task[]
  dailyRates  RoomDailyRate[]
}

// A price override for one specific night, optionally in a specific
// currency and market (local vs. foreign guest). Falls back to Room.price
// (for LOCAL) or the LOCAL resolution entirely (for FOREIGN, when no
// foreign-specific row exists) — see lib/pricing.ts's resolveNightlyRate.
model RoomDailyRate {
  id       String   @id @default(cuid())
  roomId   String
  room     Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  date     DateTime @db.Date
  currency String   // 'LKR' | 'USD' | 'GBP' | 'EUR' | 'AUD'
  market   Market   @default(LOCAL)
  price    Decimal  @db.Decimal(10, 2)

  @@unique([roomId, date, currency, market])
}

// Local (Sri Lankan) vs. foreign guest pricing tier — see /admin/pricing
// and lib/pricing.ts. Detected via geo-IP (middleware.ts) with a guest
// manual override (components/ui/MarketSwitcher.tsx).
enum Market {
  LOCAL
  FOREIGN
}

// Admin-set conversion rate for one non-LKR currency, e.g. currency='USD',
// rateToLKR=334.50 means "1 USD = 334.50 LKR". Used as the fallback when a
// room/date has no explicit RoomDailyRate override for that currency — see
// lib/pricing.ts's convertFromLKR.
model ExchangeRate {
  currency  String   @id
  rateToLKR Decimal  @db.Decimal(10, 4)
  updatedAt DateTime @updatedAt
}

// Site-wide singleton (always id: "global") for settings that don't belong
// to any one room/currency. Currently just the foreign-pricing master
// switch — see /admin/pricing and app/api/bookings/route.ts, the one place
// this is actually enforced server-side (not just hiding the UI).
model PricingSettings {
  id                    String   @id @default("global")
  foreignPricingEnabled Boolean  @default(true)
  updatedAt             DateTime @updatedAt
}

model RoomImage {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  url       String
  publicId  String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Facility {
  id       String  @id @default(cuid())
  label    String  @unique
  icon     String  @default("Check") // lucide-react icon name, resolved via lib/facility-icons.ts
  category String  @default("general") // room | bathroom | technology | food | general
  rooms    Room[]
}

model Review {
  id        String   @id @default(uuid())
  rating    Int
  comment   String?
  userId    String
  roomId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  room Room @relation(fields: [roomId], references: [id])
}

model Payment {
  id         String        @id @default(uuid())
  bookingId  String        @unique
  amount     Decimal       @db.Decimal(10, 2)
  status     PaymentStatus @default(PENDING)
  // PayHere's own payment id (distinct from our bookingNumber/order_id),
  // captured from their notify webhook — required to call the Refund API.
  // Null for bank-transfer payments and any payment recorded before this
  // field existed.
  payhereId  String?
  refundedAt DateTime?
  createdAt  DateTime      @default(now())

  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  priority    Priority     @default(MEDIUM)
  status      TaskStatus   @default(PENDING)
  category    TaskCategory
  assignedTo  String?      // User ID
  user        User?        @relation("AssignedTo", fields: [assignedTo], references: [id])
  roomId      String?
  room        Room?        @relation(fields: [roomId], references: [id])
  dueAt       DateTime?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Service {
  id          String           @id @default(cuid())
  name        String
  description String?
  price       Decimal          @db.Decimal(10, 2)
  category    String           // e.g. "Wellness", "Dining"
  isPackage   Boolean          @default(false)
  bookings    ServiceBooking[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model ServiceBooking {
  id          String   @id @default(cuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id])
  quantity    Int      @default(1)
  totalPrice  Decimal  @db.Decimal(10, 2)
  scheduledAt DateTime?
  createdAt   DateTime @default(now())
}

model Coupon {
  id              String    @id @default(cuid())
  code            String    @unique
  discountPercent Int
  validFrom       DateTime
  validUntil      DateTime
  isActive        Boolean   @default(true)
  usageCount      Int       @default(0)
  maxUsage        Int?
  createdAt       DateTime  @default(now())
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model ContactMessage {
  id         String               @id @default(cuid())
  firstName  String
  email      String
  phone      String?
  subject    String               // booking, general, feedback, complaint, other
  message    String               @db.Text
  status     ContactMessageStatus @default(UNREAD)
  starred    Boolean              @default(false)
  adminReply String?              @db.Text
  repliedAt  DateTime?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
}

enum ContactMessageStatus {
  UNREAD
  READ
  ARCHIVED
}

enum ConciergeStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model ConciergeRequest {
  id          String          @id @default(cuid())
  guestName   String
  roomNumber  String?
  service     String
  description String?
  status      ConciergeStatus @default(PENDING)
  priority    Priority        @default(MEDIUM)
  assignedTo  String?
  contact     String?
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actor      String   // admin email (or attempted email, for failed logins)
  action     String   // e.g. LOGIN_SUCCESS, LOGIN_FAILED, ROOM_CREATE, RECEIPT_APPROVE
  entityType String?  // e.g. "Room", "Booking", "BankTransferReceipt"
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actor])
  @@index([action])
  @@index([createdAt])
}

enum AdminRole {
  ADMIN     // full access, incl. managing other admins
  MANAGER   // everything except the Team screen
}

model Admin {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(MANAGER)
  avatarUrl    String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// MFA codes emailed to an admin after a correct password, before a real
// session is issued (see app/api/auth/login and app/api/auth/verify-mfa).
// Flat/no relation, matching OtpCode's existing style for phone login.
model AdminLoginCode {
  id        String   @id @default(cuid())
  adminId   String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  @@index([adminId])
}
